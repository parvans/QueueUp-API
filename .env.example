# =============================================================================
# QueueUp API — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env or any file containing real credentials.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Pooled connection string — used for all application queries.
# Append ?pgbouncer=true&connection_limit=10 to keep within Neon PgBouncer limits.
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXXXX-pooler.REGION.neon.tech/DBNAME?pgbouncer=true&connection_limit=10&sslmode=require"

# Direct connection string — used ONLY for Prisma schema migrations.
# Do NOT set pgbouncer=true here; prepared statements are required for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXXXX.REGION.neon.tech/DBNAME?sslmode=require"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(48).toString('base64') |> console.log"
JWT_SECRET=REPLACE_WITH_MIN_32_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_MIN_32_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP (SMS Provider — D-04: deferred, integration point below) ─────────────
# Set OTP_PROVIDER to one of: twilio | msg91 | fast2sms | sns
# Leave blank in development — dev mode returns the OTP in the response body.
OTP_PROVIDER=
OTP_API_KEY=
OTP_SENDER_ID=QueueUp

# ─── Firebase Cloud Messaging (push notifications) ────────────────────────────
# Required for milestone alerts pushed to mobile clients.
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only in development.
CORS_ORIGINS=*
