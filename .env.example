# QueueUp Environment Configuration
# Copy this file to .env and populate with appropriate values.

# Database Connections (Neon Serverless PostgreSQL)
# DATABASE_URL: Pooled connection string (-pooler endpoint) using PgBouncer for transactional queries
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.c-6.us-east-2.aws.neon.tech/queueup-dev?sslmode=require&channel_binding=require"

# DIRECT_URL: Direct unpooled connection string for migrations and schema introspection
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.c-6.us-east-2.aws.neon.tech/queueup-dev?sslmode=require"

# Neon PgBouncer Connection Pool Settings
# Note: DB_POOL_MAX is the pool limit per application instance.
# Ensure (DB_POOL_MAX * total_app_instances) <= Neon PgBouncer connection capacity.
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000

# Application Server
PORT=3000
NODE_ENV=development
API_PREFIX="api/v1"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:8081,exp://"

# Global Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Authentication & Cryptographic Secrets (Phase 2)
# IMPORTANT: Generate secure 256-bit secrets (>= 32 characters) using: openssl rand -hex 32
JWT_SECRET="replace-with-openssl-rand-hex-32-generated-secret-key"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Server-Side OTP Pepper (>= 32 characters, used for HMAC-SHA256 OTP hashing)
OTP_PEPPER="replace-with-openssl-rand-hex-32-generated-pepper-key"
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Phone & SMS Configuration
DEFAULT_COUNTRY_CODE="IN"
# SMS_PROVIDER: 'mock' for local dev/testing; 'twilio' or 'aws_sns' in production
SMS_PROVIDER="mock"

# Optional Development Testing Overrides (ONLY valid when NODE_ENV !== 'production')
# DEV_TEST_PHONE="+919999999999"
# DEV_TEST_OTP="123456"

# Real-Time WebSocket (Phase 7)
SOCKET_PORT=3000

# Push Notifications (FCM - Future Phase)
# FIREBASE_PROJECT_ID=""
# FIREBASE_PRIVATE_KEY=""
# FIREBASE_CLIENT_EMAIL=""
