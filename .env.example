# QueueUp Environment Configuration
# Copy this file to .env and populate with appropriate values.

# Database Connections (Neon Serverless PostgreSQL)
# DATABASE_URL: Pooled connection string (-pooler endpoint) using PgBouncer for transactional queries
DATABASE_URL="postgresql://neondb_owner:password@ep-sample-pooler.c-6.us-east-2.aws.neon.tech/queueup-dev?sslmode=require&channel_binding=require"

# DIRECT_URL: Direct unpooled connection string for migrations and schema introspection
DIRECT_URL="postgresql://neondb_owner:password@ep-sample.c-6.us-east-2.aws.neon.tech/queueup-dev?sslmode=require"

# Application Server
PORT=3000
NODE_ENV=development
API_PREFIX="api/v1"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:8081,exp://"

# Authentication (Phase 2)
JWT_SECRET="super-secret-jwt-key-replace-in-production"
JWT_EXPIRES_IN="7d"

# Real-Time WebSocket (Phase 7)
SOCKET_PORT=3000

# Push Notifications (FCM - Future Phase)
# FIREBASE_PROJECT_ID=""
# FIREBASE_PRIVATE_KEY=""
# FIREBASE_CLIENT_EMAIL=""

